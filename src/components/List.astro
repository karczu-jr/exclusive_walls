---
const { title } = Astro.props;

---

<div class="list">
    <p class="caption">{title}</p>
    <slot />
</div>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;

    .list {

        p {
            margin-bottom: 0.5rem;
            font-size: $fs-base;
            color: var(--text-color);
        }
    }
</style>