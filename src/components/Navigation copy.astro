---
const navLinks = [
    {label: "Home", href: "/"},
    {label: "Oferta druku", href: "/offer"},
    // {label: "Druk dla Firm", href: "/spaces-business"},
    // {label: "Druk dla Domu", href: "/spaces-home"},
    {label: "Jak to działa?", href: "/process"},
    {label: "Vouchery i Benefity", href: "/benefits"},
    {label: "Kontakt", href: "/contact"},
]

const { class: className, ...rest } = Astro.props;
---

<div class="site-header">
    
    <div aria-label="Nawigacja główna" class:list={["nav-bar", "wrapper", className]} {...rest}>
        
        <a class="nav-bar__logo" href="/">
            <img src="../../img/Logo_EW.svg" alt="Logo firmy Exclussive Walls">
        </a>
        
        <nav class="nav-bar__desktop" aria-label="Nawigacja główna">
            <ul class="nav-bar__desktop-list">
                {navLinks.map(link => (
                    <li>
                    <a href={link.href}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </nav>

        <button class="nav-bar__hamburger" aria-label="Otwórz menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav aria-label="Nawigacja mobilna" class="nav-bar__mobile">
            <ul class="nav-bar__mobile-list">
                {navLinks.map(link => (
                    <li>
                    <a href={link.href}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </nav>

    </div>
</div>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;

    // --- NOWE: STYLOWANIE ZEWNĘTRZNEGO HEADERA (EFEKT SZKŁA) ---
    .site-header {
        position: fixed; 
        top: 0;
        left: 0;
        width: 100%;
        z-index: 999; 
        
        // --- NOWE: Płynna animacja wysuwania/chowania ---
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);

        // --- NOWE: Klasa dodawana przez JS ukrywająca header ---
        &.is-hidden {
            transform: translateY(-100%);
        }
        
        &::before {
            // ... Twój cały efekt liquid glass zostaje tutaj bez ZMIAN!
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 140%; 
            background: linear-gradient(to bottom, rgba(0,0,0, 0.9) 0%, rgba(0,0,0, 0) 100%);
            backdrop-filter: blur(12px); 
            -webkit-backdrop-filter: blur(12px);
            mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, black 50%, transparent 100%);
            z-index: -1; 
            pointer-events: none; 
        }
    }

    .nav-bar {
        // --- 1. GLÓWNY LAYOUT (DESKTOP DEFAULT) ---
        display: flex;
        justify-content: space-between;
        align-items: center;
        // Zmieniliśmy marginesy, żeby pasowały do przyklejonego headera
        padding-top: 1.5rem; 
        padding-bottom: 2rem; 

        &__logo {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: inherit;

            img {
                height: 48px;
                width: auto;
            }
        }

        // --- 2. MENU DESKTOPOWE ---
        &__desktop {
            display: flex; 

            &-list {
                list-style: none;
                display: flex;
                gap: 40px;
                margin: 0; // Reset
                padding: 0; // Reset
            }

            a {
                text-decoration: none;
                color: $clr-white; 
                position: relative;
                padding: 4px 0;
                transition: color 0.3s ease;
                font-weight: 500;

                &::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    right: 0; 
                    width: 100%;
                    height: 1px;
                    background-color: $clr-white; 
                    transform: scaleX(0); 
                    transform-origin: bottom right;
                    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                }

                &:hover {
                    &::after {
                        transform: scaleX(1); 
                        transform-origin: bottom left;
                    }
                }
            }
        }

        // --- 3. HAMBURGER ---
        &__hamburger {
            display: none; 
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            flex-direction: column;
            gap: 6px;
            z-index: 110; // Musi być nad mobilnym menu

            span {
                display: block;
                width: 32px;
                height: 2px;
                background: $clr-white;
                transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
                transform-origin: center;
            }

            &.active {
                span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
                span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
                span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
            }
        }

        // --- 4. MENU MOBILNE ---
        &__mobile {
            display: none; 
            position: fixed;
            inset: 0;
            height: 100vh;
            width: 100%;
            background: rgba(0, 0, 0, 0.95); // Lekko przezroczyste czarne tło na mobile
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            
            transform: translateX(100%);
            transition: transform 0.5s ease-in-out;

            ul {
                display: flex;
                flex-direction: column;
                gap: 2rem;
                list-style: none;
                padding: 0;
                margin: 0;
                text-align: center;
            }

            a {
                font-size: 2rem;
                font-weight: 600;
                color: $clr-white;
                text-decoration: none;
            }

            &.active {
                transform: translateX(0);
            }
        }

        // --- 5. BREAKPOINT ---
        @include respond-to("desktop") {
            &__desktop { display: none; }
            &__hamburger { display: flex; }
            &__mobile { display: flex; }
        }       
    }
</style>

<script>
    const initMenu = () => {
        const toggle = document.querySelector('.nav-bar__hamburger');
        const mobileNav = document.querySelector('.nav-bar__mobile');
        const links = document.querySelectorAll('.nav-bar__mobile a');

        if (!toggle || !mobileNav) return;

        toggle.addEventListener('click', () => {
            toggle.classList.toggle('active');
            mobileNav.classList.toggle('active');
            
            if (mobileNav.classList.contains('active')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }
        });

        links.forEach(link => {
            link.addEventListener('click', () => {
                toggle.classList.remove('active');
                mobileNav.classList.remove('active');
                document.body.style.overflow = '';
            });
        });
    };

    // --- NOWE: Logika chowającego się Menu ---
    const initScrollHeader = () => {
        const header = document.querySelector('.site-header');
        const hamburger = document.querySelector('.nav-bar__hamburger');
        let lastScroll = 0;

        if (!header || !hamburger) return;

        window.addEventListener('scroll', () => {
            // 1. Sprawdzamy, czy jesteśmy na mobile (czy hamburger jest widoczny)
            const isMobile = window.getComputedStyle(hamburger).display !== 'none';

            // Jeśli to mobile - natychmiast przerywamy, menu ma być zawsze widoczne
            if (isMobile) {
                header.classList.remove('is-hidden');
                return;
            }

            // 2. Logika dla Desktopu
            const currentScroll = window.pageYOffset || document.documentElement.scrollTop;

            // Na samej górze strony zawsze pokazujemy menu
            if (currentScroll <= 80) {
                header.classList.remove('is-hidden');
                return;
            }

            // Jeśli scrollujemy w dół (i zjechaliśmy już kawałek) -> Chowamy
            if (currentScroll > lastScroll) {
                header.classList.add('is-hidden');
            } 
            // Jeśli scrollujemy w górę -> Pokazujemy
            else {
                header.classList.remove('is-hidden');
            }

            lastScroll = currentScroll;
        });
    };

    // Odpalamy obie funkcje
    initMenu();
    initScrollHeader();
</script>