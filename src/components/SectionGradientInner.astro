---
// GradientDivider.astro
---

<div class="gradient-divider" aria-hidden="true"></div>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;

.gradient-divider {
    width: 100%; 
    height: 300px; 
    
    // Używamy natywnej zmiennej CSS, którą zdefiniowałeś w :root
    background: linear-gradient(
        to bottom, 
        transparent 0%,
        var(--bg-color-2) 100%
    );
    
    margin-top: -300px; 
    margin-bottom: -150px; 

    position: relative;
    z-index: -1; 
    pointer-events: none; 

    // RWD
    @include respond-to("desktop") {
        height: 200px;
        margin-top: -200px;
        margin-bottom: -7rem;
    }

    @include respond-to("tablet") {
        height: 150px;
        margin-top: -150px;
        margin-bottom: -5rem;
    }

    @include respond-to("mobile") {
        height: 100px;
        margin-top: -100px;
        margin-bottom: -3rem;
    }
}
</style>