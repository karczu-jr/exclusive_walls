---
// Odbieramy klasy przekazane z zewnątrz, aby móc zmieniać tła
const { class: className, ...rest } = Astro.props;
---

<section class:list={["base-section", className]} {...rest}>

    <slot />
    
</section>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;

    // Style wspólne dla KAŻDEJ sekcji na stronie
    .base-section {
        width: 100%;
        margin-top: 9rem; 
        padding-top: 5rem;
        padding-bottom: 9rem;
        margin-bottom: 5rem;

        // RWD
        @include respond-to("desktop") {
            margin-top: 7rem;
            padding-top: 3.5rem;
            padding-bottom: 7rem;
            margin-bottom: 4rem;
        }

        @include respond-to("tablet") {
            margin-top: 5rem;
            padding-top: 3.5rem;
            padding-bottom: 7rem;
            margin-bottom: 4rem;
        }

        @include respond-to("mobile") {
            margin-top: 3rem;
            padding-top: 3.5rem;
            padding-bottom: 6rem;
            margin-bottom: 3rem;
        }
    }
</style>