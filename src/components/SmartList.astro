---
const { title, items } = Astro.props;

// LOGIKA TWORZENIA CZYTELNEGO ID
// 1. .toLowerCase() -> zamienia na małe litery ("Nasze Usługi" -> "nasze usługi")
// 2. .trim() -> usuwa spacje na początku i końcu
// 3. .replace(/\s+/g, '-') -> zamienia wszystkie spacje w środku na myślniki

const cleanTitle = title.toLowerCase().trim().replace(/\s+/g, '-');

// Tworzymy finalne ID
const listId = `list-label-${cleanTitle}`;
---

<div class="smart-list">
    <p class="caption" id={listId}>{title}</p>
    <ul aria-labelledby={listId}>
    {items.map((item) => (
        <li>
            <a 
                href={item.href} 
                target={item.href.startsWith('http') ? "_blank" : "_self"} 
                rel={item.href.startsWith('http') ? "noopener noreferrer" : ""}
            >
                {item.text}
            </a>
        </li>
    ))}
    </ul>
</div>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;

    .smart-list {
        // width: 180px;
        .caption {
            margin-bottom: 1rem;
        }
    
        ul {
            list-style-type: none;

            li {
                margin-top: 1rem;

                a {
                    font-size: $fs-md;

                    @include respond-to("desktop") {
                        font-size: $fs-base;
                    }
                }
            }
        }
    }

</style>