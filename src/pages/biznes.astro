---
import Layout from '../layouts/Layout.astro';

import HeaderIntro from '../components/HeaderIntro.astro'
import SectionIntroCenter from '../components/SectionIntroCenter.astro';
import ImageText from '../components/ImageText.astro';

import SectionLayout from '../components/SectionLayout.astro';
import SectionGradientInner from '../components/SectionGradientInner.astro';
import SectionGradientOutter from '../components/SectionGradientOutter.astro';
---

<Layout
    title="Druk dla biura i Firm - Exclusive Walls"
	description="Wykorzystaj pionowy druk cyfrowy, by nadać biuru profesjonalny charakter. Tworzymy trwałe logo na ścianie i murale UV w 1 dzień, bez przerywania pracy zespołu. Sprawdź!">

    <header>
        <HeaderIntro 
            head='Buduj prestiż marki przez branding biura'
            subHead ='Office Branding'
            imageSrc="../../img/company4.jpg"
            data-aos="fade-in">
        </HeaderIntro>
    </header>

    <main>
        <SectionIntroCenter
            title="Nowoczesny branding biura – logo na ścianie i&nbsp;grafika firmowa w&nbsp;jakości 8K."
            class="wrapper-medium custom-margin-top custom-margin-bottom max-width">

            <p>Wykorzystaj pionowy druk cyfrowy, by nadać biuru profesjonalny charakter. Tworzymy trwałe logo na ścianie, murale motywacyjne i grafiki w salach konferencyjnych. Nasze tusze UV są bezwonne i bezpieczne, a realizacja nie zakłóca pracy zespołu. Postaw na design, który inspiruje.</p>
        </SectionIntroCenter>

        <SectionGradientInner/>
            <SectionLayout class="bg-color-2">
                <ImageText
                    imageSrc="../../img/company5.jpg"
                    imageAlt="Druk w przestrzeni biurowej"
                    title="Szybka aranżacja ścian w biurze – bez pyłu, bez remontu, w&nbsp;jeden dzień."
                    data-aos="fade-up">

                    <p>Zapomnij o uciążliwym naklejaniu tapet. Nasza drukarka ścienna nanosi obraz bezpośrednio na beton, szkło czy tynk. Gwarantujemy fotograficzną precyzję i odporność na zmywanie. To idealne rozwiązanie dla firm ceniących czas, ekologię i najwyższą estetykę wykonania.</p>

                    <!-- <ArrowLink
                        linkHref="/kontakt" 
                        text="Zamów darmową wizualizację"
                    /> -->
                </ImageText>       
            </SectionLayout>
        <SectionGradientOutter/> 
    </main>
</Layout>

<style lang="scss">
@use "../styles/variables" as *;
@use "../styles/mixins" as *;
    main {
        :global(.custom-margin-top) {
            margin-top: 10rem;

            @include respond-to("desktop") { margin-top: 8rem; }
            @include respond-to("tablet") { margin-top: 6rem; }
            @include respond-to("mobile") { margin-top: 4rem; }
        }

        :global(.custom-margin-bottom) {
            margin-bottom: 12rem;

            @include respond-to("desktop") { margin-bottom: 10rem; }
            @include respond-to("tablet") { margin-bottom: 8rem; }
            @include respond-to("mobile") { margin-bottom: 6rem; }
        }

        :global(.max-width) {
            max-width: 1024px;
        }
    }
    
</style>