---
import Layout from '../layouts/Layout.astro';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import HomeGallery from '../components/HomeGallery.astro';
import Offer from '../components/Offer.astro';
import ProcessResume from '../components/ProcessResume.astro';
import Process from '../components/Process.astro';
import Steps from '../components/Steps.astro';
import Contact from '../components/Contact.astro';
import SectionLayout from '../components/SectionLayout.astro';

import SectionIntroCenter from '../components/SectionIntroCenter.astro';

import SectionGradientInner from '../components/SectionGradientInner.astro';
import SectionGradientOutter from '../components/SectionGradientOutter.astro';

import BenefitsBanner from '../components/BenefitsBanner.astro';

---

<Layout 
	title="Exclusive Walls"
	description="Druk ścienny UV 8K dla biur, hoteli, gabinetów, placówek medycznych i przedszkoli. Fotorealistyczna grafika bez spoin. Trwała aranżacja wnętrz i branding. Zapytaj o darmową wycenę!">
	
	<Header />
	<main>
		<SectionGradientInner />
			<SectionLayout class="bg-color-2">
				<HomeGallery data-aos="fade-up" />
			</SectionLayout>

		<Offer/>

		<SectionGradientInner />
			<SectionLayout class="bg-color-2">
				<ProcessResume data-aos="fade-up" />
			</SectionLayout>
		<SectionGradientOutter />

		

		<!-- <Process /> -->
		<!-- <Steps /> -->

		<BenefitsBanner data-aos="fade-up"  />

		<SectionLayout>
			<Contact data-aos="fade-up" />
		</SectionLayout>
		
	</main>
</Layout>

